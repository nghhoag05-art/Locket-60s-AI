# Secret values belong only in the backend host's environment, never a public module.
GEMINI_API_KEY=
BACKEND_ACCESS_TOKEN=
# Public HTTPS origin of the deployed backend, without a trailing path.
PUBLIC_BASE_URL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data/generated
INPUT_IMAGE_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com,cdn.locketcamera.com
IMAGE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=3
MAX_CONCURRENT=1
DOWNLOAD_TIMEOUT_MS=8000
PROVIDER_TIMEOUT_MS=32000
MAX_IMAGE_BYTES=10485760
