# Public settings only. Enter secrets in the launcher's masked prompt or process environment.
# Do not put OPENAI_API_KEY or BACKEND_ACCESS_TOKEN in this file or in .env.
# Public HTTPS origin of the deployed backend, without a trailing path.
# Leave blank when using Start-Locket-Backend.cmd: it starts a temporary HTTPS tunnel.
PUBLIC_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data/generated
INPUT_IMAGE_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com,cdn.locketcamera.com
IMAGE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=3
MAX_CONCURRENT=1
DOWNLOAD_TIMEOUT_MS=8000
PROVIDER_TIMEOUT_MS=32000
MAX_IMAGE_BYTES=10485760
